# Base runtime identity.
APP_ENV=development
APP_NAME=service_backend
APP_VERSION=0.2.0
REST_PORT=8080
LOGGER_LEVEL=debug
LOGGER_FORMAT=console
LOGGER_COLOR=always
PUBLIC_URL=http://localhost:8080

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection string.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=service_backend
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATIONS_ENABLED=true

# Explicit fixed development identity. Use AUTH_MODE=oidc to test a real provider.
AUTH_MODE=dev
AUTH_DEV_SUBJECT=developer
AUTH_DEV_USERNAME=developer
AUTH_DEV_DISPLAY_NAME=Endge Developer
AUTH_DEV_PLATFORM_ADMIN=true
IMPORT_BACKUP_RETENTION_DAYS=7
# Bounded local cache of immutable release JSON. Each backend replica owns its own cache.
RELEASE_ARTIFACT_CACHE_ENABLED=true
RELEASE_ARTIFACT_CACHE_MAX_BYTES=67108864
RELEASE_ARTIFACT_CACHE_MAX_ITEM_BYTES=16777216
AUTH_PROVIDER_ID=primary
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_ALLOWED_AUDIENCES=
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_USERNAME_CLAIM=preferred_username
AUTH_DISPLAY_NAME_CLAIM=name
AUTH_GROUPS_CLAIM=groups
AUTH_PLATFORM_ADMIN_SUBJECTS=
AUTH_PLATFORM_ADMIN_GROUPS=endge-platform-admins

# Browser login adapter. In dev identity mode /auth/login simply returns to the Configurator.
AUTH_LOGIN_ADAPTER=dev
AUTH_AUTHORIZATION_URL=
AUTH_TOKEN_URL=
AUTH_LOGOUT_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPES=openid,profile,email
AUTH_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH_RETURN_URL=http://localhost:5173
AUTH_SESSION_COOKIE_NAME=endge_configurator_session
AUTH_SESSION_ENCRYPTION_KEY_ID=v1
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_SESSION_PREVIOUS_ENCRYPTION_KEYS=
AUTH_SESSION_TTL=8h
AUTH_TRANSACTION_TTL=10m
AUTH_SESSION_CLEANUP_INTERVAL=15m
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Local Compose observability stack: backend -> collector -> Tempo.
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Prometheus exposes metrics only on the observability network.
METRICS_ENABLED=true
METRICS_BIND_ADDRESS=:9090
METRICS_HANDLER_PATH=/metrics

# Logs stay in stdout and are additionally written directly to local OpenSearch.
LOGGER_OPENSEARCH_ENABLED=true
LOGGER_OPENSEARCH_ENDPOINT=http://opensearch:9200
LOGGER_OPENSEARCH_INDEX=service-logs
LOGGER_OPENSEARCH_USERNAME=
LOGGER_OPENSEARCH_PASSWORD=
LOGGER_OPENSEARCH_INSECURE_SKIP_VERIFY=false
LOGGER_OPENSEARCH_FLUSH_INTERVAL=1s
LOGGER_OPENSEARCH_BATCH_SIZE=100
LOGGER_OPENSEARCH_QUEUE_SIZE=1000
LOGGER_OPENSEARCH_REQUEST_TIMEOUT=5s

# Grafana connects to the shared observability services over Docker network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_URL=http://prometheus:9090
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_LOG_INDEX=service-logs
OPENSEARCH_VERSION=2.19.1
OPENSEARCH_BASIC_AUTH=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
TEMPO_URL=http://tempo:3200

# Redpanda/Kafka is optional and disabled by default.
REDPANDA_ENABLED=false
REDPANDA_BROKERS=
REDPANDA_CLIENT_ID=service_backend
REDPANDA_DIAL_TIMEOUT=5s
REDPANDA_READ_BATCH_TIMEOUT=2s
REDPANDA_WRITE_TIMEOUT=10s
