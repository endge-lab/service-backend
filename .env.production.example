# Base runtime identity.
APP_ENV=production
APP_NAME=service_backend
APP_VERSION=0.2.0
REST_PORT=8080
LOGGER_LEVEL=info
LOGGER_FORMAT=json
LOGGER_COLOR=never
PUBLIC_URL=https://api.example.com
HTTP_BASE_PATH=

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=https://example.com

# PostgreSQL connection string. Set this through your secret manager in production.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable

# Production always requires an external OIDC provider (Keycloak-compatible).
AUTH_MODE=oidc
AUTH_PROVIDER_ID=primary
AUTH_ISSUER=https://keycloak.example/realms/endge
AUTH_JWKS_URL=https://keycloak.example/realms/endge/protocol/openid-connect/certs
AUTH_ALLOWED_AUDIENCES=endge-configurator
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_USERNAME_CLAIM=preferred_username
AUTH_DISPLAY_NAME_CLAIM=name
AUTH_GROUPS_CLAIM=groups
AUTH_PLATFORM_ADMIN_SUBJECTS=
AUTH_PLATFORM_ADMIN_GROUPS=endge-platform-admins
IMPORT_BACKUP_RETENTION_DAYS=7
# Bounded local cache of immutable release JSON. Each backend replica owns its own cache.
RELEASE_ARTIFACT_CACHE_ENABLED=true
RELEASE_ARTIFACT_CACHE_MAX_BYTES=67108864
RELEASE_ARTIFACT_CACHE_MAX_ITEM_BYTES=16777216

# Server-side Configurator login. Keep secrets in the deployment secret manager.
AUTH_LOGIN_ADAPTER=oidc
AUTH_AUTHORIZATION_URL=https://keycloak.example/realms/endge/protocol/openid-connect/auth
AUTH_TOKEN_URL=https://keycloak.example/realms/endge/protocol/openid-connect/token
AUTH_LOGOUT_URL=https://keycloak.example/realms/endge/protocol/openid-connect/logout
AUTH_CLIENT_ID=endge-configurator
AUTH_CLIENT_SECRET=
AUTH_SCOPES=openid,profile,email
AUTH_REDIRECT_URL=https://backend.example.com/auth/callback
AUTH_RETURN_URL=https://configurator.example.com
AUTH_SESSION_COOKIE_NAME=endge_configurator_session
AUTH_SESSION_ENCRYPTION_KEY_ID=v1
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_SESSION_PREVIOUS_ENCRYPTION_KEYS=
AUTH_SESSION_TTL=8h
AUTH_TRANSACTION_TTL=10m
AUTH_SESSION_CLEANUP_INTERVAL=15m
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# OpenTelemetry is optional. Enable it only when you have a collector/exporter endpoint.
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false

# Prometheus exposes metrics only on the observability network.
METRICS_ENABLED=true
METRICS_BIND_ADDRESS=:9090
METRICS_HANDLER_PATH=/metrics

# OpenSearch is optional. Logs always remain available in container stdout.
LOGGER_OPENSEARCH_ENABLED=false
LOGGER_OPENSEARCH_ENDPOINT=
LOGGER_OPENSEARCH_INDEX=service-logs
LOGGER_OPENSEARCH_USERNAME=
LOGGER_OPENSEARCH_PASSWORD=
LOGGER_OPENSEARCH_INSECURE_SKIP_VERIFY=false
LOGGER_OPENSEARCH_FLUSH_INTERVAL=1s
LOGGER_OPENSEARCH_BATCH_SIZE=100
LOGGER_OPENSEARCH_QUEUE_SIZE=1000
LOGGER_OPENSEARCH_REQUEST_TIMEOUT=5s

# Grafana connects to the shared observability services over Docker network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_URL=http://prometheus:9090
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_LOG_INDEX=service-logs
OPENSEARCH_VERSION=2.0.0
OPENSEARCH_BASIC_AUTH=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
TEMPO_URL=http://tempo:3200

# Redpanda/Kafka is optional and disabled by default.
REDPANDA_ENABLED=false
REDPANDA_BROKERS=
REDPANDA_CLIENT_ID=service_backend
REDPANDA_DIAL_TIMEOUT=5s
REDPANDA_READ_BATCH_TIMEOUT=2s
REDPANDA_WRITE_TIMEOUT=10s
